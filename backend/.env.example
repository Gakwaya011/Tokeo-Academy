NODE_ENV=development
PORT=4000

# Postgres connection string from Render (Dashboard → your database → "External Database URL")
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Any long random string — used to sign auth tokens
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# The frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# From Cloudinary Dashboard → "API Environment variable" (used for Programs/Insights image uploads)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Google OAuth (console.cloud.google.com → APIs & Services → Credentials → OAuth client, "Web application")
# The callback URL must be registered verbatim as an "Authorized redirect URI" on that client.
# Local dev: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://tokeoacademy.org/api/auth/google/callback
