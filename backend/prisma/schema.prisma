generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments   Payment[]
  enrollment Enrollment?

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Payment {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  txRef            String        @unique
  amount           Int
  currency         String
  status           PaymentStatus @default(PENDING)
  flwTransactionId String?
  createdAt        DateTime      @default(now())

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

model Enrollment {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id])
  status    EnrollmentStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime         @default(now())

  @@map("enrollments")
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
}

model ContactSubmission {
  id           String           @id @default(uuid())
  name         String
  email        String
  phone        String
  userType     String
  interestType String
  message      String?
  status       SubmissionStatus @default(NEW)
  createdAt    DateTime         @default(now())

  @@map("contact_submissions")
}

enum SubmissionStatus {
  NEW
  READ
}

model Program {
  id            String   @id @default(uuid())
  number        String
  slug          String   @unique
  title         String
  tagline       String
  challenge     String
  artifact      String
  quote         String
  imageUrl      String?
  imagePublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("programs")
}

model Insight {
  id            String   @id @default(uuid())
  slug          String   @unique
  category      String
  title         String
  excerpt       String
  body          String[]
  imageUrl      String?
  imagePublicId String?
  imageFocus    String   @default("center")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("insights")
}
